# Host port published for nginx (maps host:3030 -> container:3000).
APP_PORT=3030

# Build-time public URLs (optional; baked into the Next.js bundle).
NEXT_PUBLIC_SITE_URL=https://addistech.com
NEXT_PUBLIC_API_URL=

# Production deploy only — set by CI or deploy-with-rollback.sh on the server.
# APP_IMAGE=ghcr.io/org/addis-tach-prod:latest

# Runtime secrets (optional).
GEMINI_API_KEY=
