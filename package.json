  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "eslint --max-warnings=0 --fix . && tsc --noEmit",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint:check": "eslint --max-warnings=0 . && tsc --noEmit",
    "prepare": "husky",
    "i18n:to-csv": "node scripts/i18n-csv-converter.mjs to-csv",
    "i18n:to-json": "node scripts/i18n-csv-converter.mjs to-json",
    "i18n:to-excel": "source venv/bin/activate && python3 scripts/csv-to-excel.py",
    "i18n:json-to-excel": "source venv/bin/activate && python3 scripts/json-to-excel.py",
    "i18n:excel-to-json": "source venv/bin/activate && python3 scripts/excel-to-json.py"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write",
      "tsc --noEmit"
